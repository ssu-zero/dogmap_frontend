# Browser requests go directly to the HTTPS API. The backend CORS allowlist
# must contain this app's origin (localhost, production, or preview).
NEXT_PUBLIC_API_URL=https://api.dogmap.store/
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
# Set only for the deterministic, server-free harness used by Playwright.
NEXT_PUBLIC_APP_MODE=live
